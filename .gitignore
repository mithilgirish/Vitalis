# ==========================================
# Root .gitignore for Vitalis Monorepo
# ==========================================

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Operating System & Editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# --- Build & Distribution ---
.dist/
dist/
build/
out/

# --- Python (FastAPI & ML Pipeline) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter Notebooks & ML Data ---
.ipynb_checkpoints/
ml_pipeline/data/*.csv
ml_pipeline/data/*.parquet
ml_pipeline/data/*.zip
ml_pipeline/data/*.tar.gz
# Keep gitkeep/readme in data directory
!ml_pipeline/data/README.md
!ml_pipeline/data/.gitkeep
*.h5
*.joblib
*.pkl
*.model

# --- Node / Web / Mobile Fallbacks ---
node_modules/
.next/
.expo/
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
