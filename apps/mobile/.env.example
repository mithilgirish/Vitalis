# ==============================================================================
# Vitalis Mobile Client (Expo / React Native)
# Copy this file to apps/mobile/.env or apps/mobile/.env.local
# ==============================================================================

EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# TomTom Routing API Key (Traffic-aware emergency routing)
# Free registration at: https://developer.tomtom.com
EXPO_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
