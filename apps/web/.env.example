# ==============================================================================
# Vitalis Web Command Center Environment Configuration Template
# Copy this file to apps/web/.env.local or apps/web/.env
# ==============================================================================

# Backend API URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Credentials (optional for cloud persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# TomTom Developer API Key (Traffic-aware routing, ETA estimation & hospital geocoding)
# Register for a free API key at: https://developer.tomtom.com
NEXT_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key_here

# Fallback alias for convenience
TOMTOM_API_KEY=your_tomtom_api_key_here
