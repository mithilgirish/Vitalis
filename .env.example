# ==============================================================================
# Vitalis Monorepo Environment Configuration Template
# Copy this file to .env or create project-specific .env files as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Supabase (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string with PostGIS enabled
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitalis

# Supabase API project credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. FastAPI Backend & Agent Gateway
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# LLM provider configuration for LangChain ReAct Agent
OPENAI_API_KEY=sk-your-openai-api-key
MODEL_NAME=gpt-4o

# Routing & Transit Viability (OSRM / OpenStreetMap)
OSRM_BASE_URL=https://router.project-osrm.org

# ------------------------------------------------------------------------------
# 3. Machine Learning Pipeline Artifacts & Guardrails
# ------------------------------------------------------------------------------
PROPHET_MODEL_PATH=ml_pipeline/models/prophet_model.pkl
XGB_STOCKOUT_MODEL_PATH=ml_pipeline/models/xgb_stockout.json
STOCKOUT_RISK_THRESHOLD=0.40

# ------------------------------------------------------------------------------
# 4. Next.js Command Center (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. React Native / Expo Courier Client (apps/mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_API_URL=http://localhost:8000
